{
  "name": "book-club-map",
  "version": "1.0.0",
  "description": "Interactive map of books read by the Lecture d'ailleurs book club",
  "type": "module",
  "private": true,
  "scripts": {
    "prebuild": "node generate_manifest.js",
    "build": "tsc",
    "parse": "node meetup_parser.js",
    "serve": "node scripts/static-server.mjs",
    "pretest": "npm run build",
    "test": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test --ui"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
